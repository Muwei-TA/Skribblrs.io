<section class="container d-none" id="settings">
    <div class="row justify-content-between mx-0">
        <div class="col-md-6 order-2 order-md-0 bg-white rounded h-100 p-3">
            <h1 class="text-center">游戏设置</h1>
            <div class="input-group mb-3">
                <label class="input-group-text" for="rounds">回合数</label>
                <select class="form-select" id="rounds">
                    <option value="2" selected>2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="7">7</option>
                    <option value="8">8</option>
                    <option value="9">9</option>
                    <option value="10">10</option>
                </select>
            </div>
            <div class="input-group mb-3">
                <label class="input-group-text" for="time">绘画时间（秒）</label>
                <select class="form-select" id="time">
                    <option value="30">30</option>
                    <option value="40" selected>40</option>
                    <option value="50">50</option>
                    <option value="60">60</option>
                    <option value="70">70</option>
                    <option value="80">80</option>
                    <option value="90">90</option>
                    <option value="100">100</option>
                    <option value="110">110</option>
                    <option value="120">120</option>
                    <option value="130">130</option>
                    <option value="140">140</option>
                    <option value="150">150</option>
                    <option value="160">160</option>
                    <option value="170">170</option>
                    <option value="180">180</option>
                </select>
            </div>
            <div class="input-group mb-3">
                <label for="language" class="input-group-text">词库语言</label>
                <select id="language" class="form-select">
                    <option value="Chinese" selected>简体中文</option>
                    <option value="Assamese">阿萨姆语</option>
                    <option value="Bengali">孟加拉语</option>
                    <option value="English">英语</option>
                    <option value="Gujarati">古吉拉特语</option>
                    <option value="Hindi">印地语</option>
                    <option value="Kannada">卡纳达语</option>
                    <option value="Malayalam">马拉雅拉姆语</option>
                    <option value="Nepali">尼泊尔语</option>
                    <option value="Oriya">奥里亚语</option>
                    <option value="Punjabi">旁遮普语</option>
                    <option value="Tamil">泰米尔语</option>
                    <option value="Telugu">泰卢固语</option>
                </select>
            </div>
            <% if(!roomID) { %>
            <div class="input-group mb-3">
                <label class="input-group-text" for="customeWords">自定义词语</label>
                <textarea class="form-control" placeholder="词语一&#10;词语二&#10;词语三" id="customWords"
                    style="height: 20vh; resize:none"></textarea>
            </div>
            <div class="mb-3">
                <label for="probability" class="form-label">自定义词语出现概率</label>
                <input type="range" class="form-range" min="0" max="1" step="0.01" id="probability">
            </div>
            <% } %>
            <button class="btn btn-primary w-100" id="startGame">开始游戏</button>
        </div>
        <div class="col-md-6 text-white h-100 p-3">
            <h1 class="text-center">玩家列表</h1>
            <div class="row mt-4 mx-0" style="height: 20em; overflow-y: auto;" id="playersDiv"></div>
        </div>
    </div>
    <div class="mt-5">
        <h1 class="text-white text-center">邀请好友一起玩！</h1>
        <div class="input-group mb-3">
            <input type="text" id="gameLink" class="form-control text-center fw-bold bg-white"
                value="http://localhost:3000/" readonly>
            <button class="btn btn-warning" type="button" id="copy">复制链接</button>
        </div>
    </div>
</section>
